export const saveMistakesController = async (req, res) => {
  try {
    const { email, mistakes } = req.body;

    if (!email || !Array.isArray(mistakes)) {
      return res.status(400).json({
        message: "Маълумоти хатогиҳо нодуруст аст.",
      });
    }

    const users = await getUsers();

    const index = users.findIndex(
      (user) => user.email?.toLowerCase() === email.trim().toLowerCase(),
    );

    if (index === -1) {
      return res.status(404).json({
        message: "Корбар ёфт нашуд.",
      });
    }

    users[index].mistakes = mistakes;

    await saveUsers(users);

    return res.status(200).json({
      message: "Хатогиҳо сабт шуданд.",
      mistakes: users[index].mistakes,
    });
  } catch (error) {
    console.error("Save mistakes error:", error);

    return res.status(500).json({
      message: "Сабт кардани хатогиҳо муяссар нашуд.",
    });
  }
};

export const deleteUserController = async (req, res) => {
  try {
    const users = await getUsers();

    const index = users.findIndex(
      (user) => String(user.id) === String(req.params.id),
    );

    if (index === -1) {
      return res.status(404).json({
        message: "Корбар ёфт нашуд.",
      });
    }

    if (users[index].role === "admin") {
      return res.status(403).json({
        message: "Ҳисоби администраторро нест кардан мумкин нест.",
      });
    }

    users.splice(index, 1);
    await saveUsers(users);

    return res.status(200).json({
      message: "Корбар нест карда шуд.",
    });
  } catch (error) {
    console.error("Delete user error:", error);

    return res.status(500).json({
      message: "Нест кардани корбар муяссар нашуд.",
    });
  }
};
