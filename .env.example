# Groq (ИИ-помощник Ё-Aql) — без него сервер не запустится
GROQ_API_KEY=
# Подпись токенов входа
JWT_SECRET=
# Gmail для писем с кодом (локально)
EMAIL_USER=
EMAIL_PASS=
# Brevo — письма через HTTPS (нужно на Railway, там SMTP закрыт). Пусто = Gmail
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Адреса фронтенда через запятую (на сервере)
CORS_ORIGINS=

# PostgreSQL: на Railway — DATABASE_URL, локально — DB_*
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yo_frontend
DB_PASSWORD=

# Администратор: при запуске создаётся или получает этот пароль (scripts/init-db.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
